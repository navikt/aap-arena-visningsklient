{
  "name": "aap-arena-visningsklient",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn dev:mock",
    "dev:mock": "dotenv -e .env.mock -- next dev",
    "dev:local": "dotenv -e .env.local-backend -- next dev",
    "dev:dev-gcp": "dotenv -e .env.dev-gcp-extra -e .env.dev-gcp-obo-tokens -e .env.dev-gcp -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint app lib components && prettier --check app lib components",
    "lint:fix": "oxlint --fix app lib components",
    "run-prettier": "prettier --write ./app ./lib ./components",
    "test": "vitest run"
  },
  "dependencies": {
    "@navikt/ds-css": "8.3.0",
    "@navikt/ds-react": "8.3.0",
    "@navikt/oasis": "4.1.4",
    "date-fns": "4.1.0",
    "graphql": "16.13.0",
    "graphql-request": "7.4.0",
    "jose": "6.1.3",
    "next": "16.1.6",
    "prom-client": "15.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "winston": "3.19.0",
    "winston-syslog": "2.7.1"
  },
  "devDependencies": {
    "@navikt/aap-felles-prettier": "5.5.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/winston-syslog": "^2",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "8.0.0",
    "eslint": "10.0.0",
    "eslint-config-next": "16.1.6",
    "oxlint": "1.50.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "packageManager": "yarn@4.12.0"
}
