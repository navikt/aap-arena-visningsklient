{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "rules": {
    "react/display-name": "error",
    "react/prop-types": "off",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-extra-non-null-assertion": "off",
    "no-console": "error",
    "prefer-const": "error",
    "no-var": "error"
  }
}
